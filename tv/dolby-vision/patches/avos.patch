+	JNIEnv *env = NULL;
+	int detach = 0;
+	jboolean enabled = JNI_FALSE;
+	if (!jCodecDiscoveryClass || !jDoViCompatibilityMethod)
+		return 0;
+	if ((*myVm)->GetEnv(myVm, (void **)&env, JNI_VERSION_1_4) != JNI_OK) {
+		if ((*myVm)->AttachCurrentThread(myVm, &env, NULL) != JNI_OK)
+			return 0;
+		detach = 1;
+	}
+	enabled = (*env)->CallStaticBooleanMethod(env, jCodecDiscoveryClass, jDoViCompatibilityMethod);
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionClear(env);
+		enabled = JNI_FALSE;
+	}
+	if (detach)
+		(*myVm)->DetachCurrentThread(myVm);
+	return enabled == JNI_TRUE;
 }
 
